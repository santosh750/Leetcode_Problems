class Solution {
    public int longestConsecutive(int[] nums) {
        int n = nums.length;
        if(n == 0)return 0;
        Set<Integer> set = new HashSet<>();
        for(int i=0;i<nums.length;i++){
            set.add(nums[i]);
        }
        int count = 0;
        int largest = 1;
        int x =0;
        for(int it:set){
            if(!set.contains(it-1)){
                count = 1;
                x = it;
            }
            while(set.contains(x+1)){
                x = x+1;
                count = count+1;
            }
            largest = Math.max(largest,count);
        }
        return largest;
    }
}
