class Solution {
    public int removeElement(int[] nums, int val) {
        int i=0;
        int j=0;
        while(j<=nums.length-1){
            if(i==0 && j==0){
                j++;
            }
            else if(j!=0){
                j++;
            }
            nums[i] = nums[j];
            nums[j] =0;
            i++;
            j++;
        }
    }
}
