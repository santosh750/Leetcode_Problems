class Solution {
    public int countOccurrences(int[] arr, int target) {
        int left = binarySearch(arr,target,true);
        int right = binarySearch(arr,target,false);
        return right - left+1;
    }
    public int binarySearch(int[] nums, int target,boolean isSearchingLeft){
        int ind = 0;
        int low = 0, high = nums.length-1;
        while(low <= high){
            int mid = low + (high - low) / 2;
            if(nums[mid] < target){
                low = mid+1;
            }
            else if(nums[mid] > target){
                high = mid-1;
            }
            else{
                ind = mid;
                if(isSearchingLeft){
                    high = mid-1;
                }
                else{
                    low = mid+1;
                }
            }
        }
        return ind;
    }
}
